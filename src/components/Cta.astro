---
/** Fascia CTA color accento in fondo alle pagine. Il segno grafico è un motivo neutro della base:
 *  al riempimento si può sostituire con il segno/monogramma del cliente, mantenendo il riquadro. */
import { site } from '../data/site';
import { cta } from '../data/contenuti';
---
<section class="cta section-sm"> <svg class="gmark" width="416" height="416" viewBox="0 0 64 64" fill="none" aria-hidden="true">  <rect x="8" y="8" width="48" height="48" stroke="currentColor" stroke-width="3" stroke-dasharray="7 5"></rect> </svg> <div class="container"> <div class="narrow reveal"> <p class="eyebrow-light mb-2">{cta.eyebrow}</p> <h2 class="h2">{cta.titolo}</h2> <p class="lead mt-2" style="color: rgb(255 255 255 / 0.88)">{cta.testo}</p> <div class="btn-row mt-4"> <a href="/contatti/#richiesta" class="btn btn-primary">Contattaci</a> {site.telefono ? <a href={`tel:${site.telefonoE164}`} class="btn btn-outline-light">Chiama {site.telefono}</a> : <a href={`mailto:${site.email}`} class="btn btn-outline-light">{site.email}</a>} </div> </div> </div> </section>
