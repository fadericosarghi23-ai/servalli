---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ProcessCards from '../components/ProcessCards.astro';
import Cta from '../components/Cta.astro';
import { progetto } from '../data/progetti';
import { fasi } from '../data/contenuti';

// La pagina a card + elenco della base ospita le 12 news del sito (vedi src/data/contenuti.ts).
const crumbs = [{ name: 'Home', href: '/' }, { name: 'News', href: '/news/' }];
const hero = progetto('casa-di-riposo-musicisti-fondazione-giuseppe-verdi').immagini[0];
---
<Layout title="News | Studio Servalli Architettura, Bergamo" description="Progetti recenti e aggiornamenti dello Studio Servalli Architettura: Ex Borsa Merci di Bergamo, ville storiche, l’Italian Heritage Award e i progetti all’estero." ogType="article" transparent crumbs={crumbs}>
<PageHero img={hero} crumbs={crumbs} eyebrow="News"> <h1 class="h1-page">Progetti e <em>aggiornamenti</em></h1> <p class="lead">Gli ultimi progetti dello studio, i riconoscimenti e gli studi di fattibilità, in Italia e all’estero.</p> </PageHero>
<section class="section"> <div class="container"> <ProcessCards h="h2" /> </div> </section>
<section class="section bg-sand"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow mb-2">Archivio</p> <h2 class="h2">Altre news dallo studio</h2> <p class="lead mt-2">Restauri, riqualificazioni urbane e progetti di paesaggio degli ultimi anni.</p> </div> <a href="/progetti/" class="btn btn-primary">Vedi i progetti</a> </div> <ol class="steps"> {fasi.map((f, i) => <li id={`fase-${i + 1}`} class="reveal" style={`transition-delay:${(i % 3) * 60}ms`}> <span class="n">{String(i + 1).padStart(2, '0')}</span> <h3 class="h4">{f.titolo}</h3> <p>{f.testo}</p> </li>)} </ol> </div> </section>
<Cta />
</Layout>
