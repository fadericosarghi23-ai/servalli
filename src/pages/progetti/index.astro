---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import Portfolio from '../../components/Portfolio.astro';
import Cta from '../../components/Cta.astro';
import { abs } from '../../data/site';
import { progetti } from '../../data/progetti';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Progetti', href: '/progetti/' }];
const ld = [{
  '@type': 'ItemList',
  name: 'Progetti',
  numberOfItems: progetti.length,
  itemListElement: progetti.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(`/progetti/${p.slug}/`), name: p.titolo })),
}];
---
<Layout title="Progetti | Studio Servalli Architettura, restauro a Bergamo" description="28 progetti dello Studio Servalli Architettura: restauro di immobili di pregio e architetture religiose, riqualificazione di aree urbane e architettura d’interni." pageType="CollectionPage" crumbs={crumbs} ld={ld}>
<PageHead crumbs={crumbs} eyebrow="Portfolio" title="Progetti"> <p class="lead mt-3 narrow">{progetti.length} progetti in quattro ambiti: restauro di immobili di pregio e di architetture religiose, riqualificazione di aree urbane e architettura d’interni.</p> </PageHead>
<Portfolio lista={progetti} />
<Cta />
</Layout>
